{
  "name": "hal-goodly-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "hal-server"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --disable-nested-config",
    "format": "oxfmt . '!repos/**'",
    "format:check": "oxfmt --check . '!repos/**'",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.5.3"
  }
}
