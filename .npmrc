# Disable the supply-chain release-age cooldown for THIS repo only.
# Hal targets Effect 4 and Alchemy 2, both of which are on prerelease tags
# published far more recently than the user-level ~/.npmrc `min-release-age=14`
# allows, so installs otherwise fail with ETARGET ("no matching version ...
# with a date before"). Other projects keep the 14-day cooldown.
min-release-age=0
